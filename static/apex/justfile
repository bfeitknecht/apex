default:
    @just --list

compile:
    #!/usr/bin/env sh
    set -eu
    rm -rf public
    if [ -d vendor ]; then
        PKG_DIR="$(mktemp -d)"
        trap 'rm -rf "$PKG_DIR"' EXIT
        mkdir -p "$PKG_DIR/preview/exemel" "$PKG_DIR/preview/thyme"
        [ -d vendor/exemel ] && cp -R vendor/exemel "$PKG_DIR/preview/exemel/0.3.0"
        [ -d vendor/thyme ] && cp -R vendor/thyme "$PKG_DIR/preview/thyme/0.1.0"
        typst compile --features html,bundle --format bundle --package-path "$PKG_DIR" site.typ public
    else
        typst compile --features html,bundle --format bundle site.typ public
    fi

serve:
    #!/usr/bin/env sh
    set -eu
    if [ -d vendor ]; then
        PKG_DIR="$(mktemp -d)"
        trap 'rm -rf "$PKG_DIR"' EXIT
        mkdir -p "$PKG_DIR/preview/exemel" "$PKG_DIR/preview/thyme"
        [ -d vendor/exemel ] && cp -R vendor/exemel "$PKG_DIR/preview/exemel/0.3.0"
        [ -d vendor/thyme ] && cp -R vendor/thyme "$PKG_DIR/preview/thyme/0.1.0"
        typst watch --features html,bundle --format bundle --package-path "$PKG_DIR" --port 8080 site.typ public
    else
        typst watch --features html,bundle --format bundle --port 8080 site.typ public
    fi

dev: compile
    #!/usr/bin/env python3
    import functools
    import http.server
    import pathlib

    root = pathlib.Path("public").resolve()
    not_found = root / "404.html"

    class Handler(http.server.SimpleHTTPRequestHandler):
        extensions_map = {
            **http.server.SimpleHTTPRequestHandler.extensions_map,
            ".typ": "text/plain; charset=utf-8",
            ".woff2": "font/woff2",
        }

        def translate_path(self, path):
            p = path.split("?", 1)[0]
            if p == "/cv":
                return str(root / "cv.pdf")
            if p in ("/noscript", "/noscript/"):
                return str(root / "index.html")
            return super().translate_path(path)

        def send_error(self, code, message=None, explain=None):
            if code == 404 and not_found.is_file():
                body = not_found.read_bytes()
                self.send_response(404)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(body)
                return
            super().send_error(code, message, explain)

    handler = functools.partial(Handler, directory=str(root))
    with http.server.ThreadingHTTPServer(("", 8080), handler) as httpd:
        print(f"serving {root} on http://localhost:8080")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\nstopped")

install-packages:
    #!/usr/bin/env sh
    set -eu
    if [ "$(uname -s)" = "Darwin" ]; then
        cache_root="$HOME/Library/Application Support/typst/packages"
    else
        cache_root="${XDG_DATA_HOME:-$HOME/.local/share}/typst/packages"
    fi
    for manifest in vendor/*/typst.toml; do
        [ -f "$manifest" ] || continue
        pkg_dir="$(cd "$(dirname "$manifest")" && pwd)"
        pkg_name="$(sed -n 's/^name = "\(.*\)"/\1/p' "$manifest")"
        pkg_ver="$(sed -n 's/^version = "\(.*\)"/\1/p' "$manifest")"
        mkdir -p "$cache_root/preview/$pkg_name"
        rm -rf "$cache_root/preview/$pkg_name/$pkg_ver"
        ln -s "$pkg_dir" "$cache_root/preview/$pkg_name/$pkg_ver"
        echo "linked @preview/$pkg_name:$pkg_ver -> $cache_root/preview/$pkg_name/$pkg_ver"
    done

build:
    docker build -t ghcr.io/bfeitknecht/apex:dev .

preview:
    docker rm -f apex-preview >/dev/null 2>&1 || true
    docker run -d --rm --name apex-preview -p 8080:8080 ghcr.io/bfeitknecht/apex:dev
    @echo "→ http://apex-preview.orb.local:8080 (OrbStack) or http://localhost:8080 (Linux)"

release $tag="" $message="":
    #!/usr/bin/env sh
    set -eu
    tag="${tag:-}"
    message="${message:-}"
    if [ -z "$tag" ]; then
        printf 'release tag: '
        read -r tag || tag=""
    fi
    if [ -z "$message" ]; then
        printf 'release message: '
        read -r message || message=""
    fi
    if [ -z "$tag" ]; then
        echo "release: no tag given" >&2
        exit 1
    fi
    if [ -z "$message" ]; then
        echo "release: no message given" >&2
        exit 1
    fi
    if ! git check-ref-format "refs/tags/$tag" >/dev/null 2>&1; then
        echo "release: '$tag' is not a valid tag name" >&2
        exit 1
    fi
    if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
        echo "release: tag $tag already exists" >&2
        exit 1
    fi
    if ! git remote get-url origin >/dev/null 2>&1; then
        echo "release: no 'origin' remote configured" >&2
        exit 1
    fi
    git add -A
    if ! git diff --cached --quiet; then
        git commit -m "$message"
    elif git rev-parse -q --verify HEAD >/dev/null; then
        echo "release: nothing to commit, tagging HEAD"
    else
        echo "release: nothing to commit and no commits yet" >&2
        exit 1
    fi
    git tag -a "$tag" -m "$message"
    git push origin HEAD
    git push origin "$tag"
    echo "release: pushed $tag"
