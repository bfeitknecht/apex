# The container runs its own SSH server (`apex-ssh`, russh) and needs port 22 to
# itself. This file is the alternative: let the host's OpenSSH listen on 22 and
# run the portfolio as a forced command, which avoids a second daemon and gets
# you sshd's rate limiting, fail2ban and logging for free.
#
#   useradd --system --create-home --shell /usr/sbin/nologin payload
#   cargo build --release            # the native binary, no `ssh` feature
#   install -m755 target/release/apex /usr/local/bin/apex
#
# Then merge this into /etc/ssh/sshd_config and `systemctl reload sshd`.
# `ssh 0xbf.ch` then lands in the portfolio: the account has no shell, no
# forwarding and no rc file, and ForceCommand ignores whatever was asked for.
#
# Prefer this if `ssh 0xbf.ch` must share port 22 with anything else, or if you
# want a real audit trail of who connected. The trade-off is that the account
# exists as a real system user, and that the binary must be rebuilt and
# installed by hand instead of shipped as an image.
Match User payload
    ForceCommand /usr/local/bin/apex
    PermitTTY yes
    DisableForwarding yes
    X11Forwarding no
    PermitTunnel no
    PermitUserRC no
